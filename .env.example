# ============================================================
# REQUIRED - You must set these for the app to work
# ============================================================

# These three settings work together: pick a provider, then give the
# connection details for THAT provider. Switching providers means
# changing these three lines and nothing else.

# Which provider serves chat: "openrouter" or "ollama".
# There is no default - the app tells you at startup if this is unset.
LLM_PROVIDER=openrouter

# Your API key for the provider above.
# OpenRouter: get one at https://openrouter.ai/keys
# Ollama local: not needed, leave it empty
# Ollama cloud: your key from https://ollama.com/settings/keys
LLM_API_KEY=sk-or-v1-your-key-here

# Where to reach the provider. Leave it commented to use the default for
# whichever LLM_PROVIDER you chose:
#   openrouter -> https://openrouter.ai/api/v1
#   ollama     -> http://localhost:11434/v1
# Set it only to point somewhere else, e.g. Ollama cloud:
# LLM_BASE_URL=https://ollama.com/v1

# ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽
# OPTIONAL Reasonable defaults, override if needed/troubleshooting  ▽
# ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽

# --- Model ---
# Model used when the user hasn't picked one. If .models_list exists it
# must be listed there; if not, any model the active provider offers
# works (for Ollama, one you've pulled, e.g. llama3.2:3b).
# DEFAULT_MODEL=deepseek/deepseek-v4-flash

# --- ChromaDB (only needed for ☁︎ cloud mode) ---
# CHROMADB_API_KEY=your-chromadb-api-key-here

# --- Server ---
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# SERVER_PORT_RETRIES=5

# --- Logging ---
# LOG_LEVEL_APP=DEBUG
# LOG_LEVEL_DEPS=INFO
# LOG_TO_STDOUT=true
# LOG_TO_FILE=true
# LOG_FILE_PATH=logs/app.log

# --- Chat History ---
# Logs ALL chat interactions to a JSONL file
# CHAT_HISTORY_ENABLED=false
# CHAT_HISTORY_PATH=logs/chat-history.jsonl
