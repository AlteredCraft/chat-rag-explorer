# ============================================================
# REQUIRED - You must set these for the app to work
# ============================================================

# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ 
# OPTIONAL Reasonable defaults, override if needed/troubleshooting  ▽
# ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽ ▽

# --- LLM Provider ---
# Any OpenAI-compatible endpoint works (e.g. a local Ollama at
# http://localhost:11434/v1). Defaults to OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used when the user hasn't picked one. Must be listed in .models_list.
# DEFAULT_MODEL=deepseek/deepseek-v4-flash

# --- ChromaDB (only needed for ☁︎ cloud mode) ---
# CHROMADB_API_KEY=your-chromadb-api-key-here

# --- Server ---
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# SERVER_PORT_RETRIES=5

# --- Logging ---
# LOG_LEVEL_APP=DEBUG
# LOG_LEVEL_DEPS=INFO
# LOG_TO_STDOUT=true
# LOG_TO_FILE=true
# LOG_FILE_PATH=logs/app.log

# --- Chat History ---
# Logs ALL chat interactions to a JSONL file
# CHAT_HISTORY_ENABLED=false
# CHAT_HISTORY_PATH=logs/chat-history.jsonl
